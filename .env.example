# Copy to .env and fill in real values. Never commit .env.
# See docs/DEPLOYMENT.md §1 for the full category breakdown.

# --- DATABASE ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lose10
DATABASE_USER=lose10
DATABASE_PASSWORD=lose10
DATABASE_POOL_SIZE=10

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- CLAUDE (AI provider, see docs/AI_ARCHITECTURE.md) ---
CLAUDE_API_KEY=
CLAUDE_MODEL_ID=

# --- EMBEDDING (see docs/MEMORY.md) ---
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSION=1536

# --- WHATSAPP (see docs/WHATSAPP.md) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- STRIPE (see docs/BUSINESS_LOGIC.md) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- AUTH ---
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# --- EMAIL (AWS SES, see docs/DEPLOYMENT.md) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# --- OBSERVABILITY ---
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_ERROR_MONITORING_DSN=

# --- Frontend (see frontend/.env.example) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
